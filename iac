provider-variables.tf
# ==============================================================================
# PATRA CORP - EXECUTIVE BLUEPRINT: FDS INFRASTRUCTURE PROVISIONING & FINOPS VARS
# ==============================================================================

variable "environment_tier" {
  type        = string
  description = "Target deployment pipeline phase for the Forward Deployed Squad workspace."
  default     = "staging"
  
  validation {
    condition     = contains(["dev", "staging", "prod-carrier-mesh"], var.environment_tier)
    error_message = "The infrastructure deployment tier must be dev, staging, or prod-carrier-mesh."
  }
}

variable "finops_cost_center_tags" {
  type        = map(string)
  description = "Mandatory multi-tenant asset tags to monitor and map AWS EKS compute budgets back to individual client verticals."
  default = {
    "Provisioner" = "Central-Platform-IDP"
    "ManagedBy"   = "Forward-Deployed-Squad-FDS"
    "FinOpsAudit" = "Automated-Kubecost-Tracking"
    "DataPrivacy" = "HIPAA-SOC2-Compliant-Isolation"
  }
}

variable "agent_compute_ceilings" {
  type = map(object({
    cpu_limit    = string
    memory_limit = string
    max_replicas = number
  }))
  description = "Strict cluster limits enforced dynamically per tenant workspace to prevent LLM scaling cost overruns."
  default = {
    "standard-fds-squad" = {
      cpu_limit    = "4000m"
      memory_limit = "8Gi"
      max_replicas = 5
    }
    "high-compute-agent-mesh" = {
      cpu_limit    = "16000m"
      memory_limit = "32Gi"
      max_replicas = 20
    }
  }
}
